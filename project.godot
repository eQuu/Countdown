;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Laser Heist"
config/version="1.0"
run/main_scene="uid://cjp4jtcm2kqrv"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="uid://bub5rjye4btdt"

[autoload]

GameStore="*res://scripts/game/GameStore.cs"
PlayerColorStore="*res://scripts/player/PlayerColorStore.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Countdown"

[editor_plugins]

enabled=PackedStringArray("res://addons/MagicaVoxel_Importer_with_Extensions/plugin.cfg")

